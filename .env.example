# Configuración de Base de Datos
DATABASE_URL=mysql+pymysql://root@localhost/ndata

# Seguridad
SECRET_KEY=TU_LLAVE_SECRETA_SUPER_SEGURA

# Configuración de Email (Gmail)
# Para obtener una contraseña de aplicación de Gmail:
# 1. Ve a https://myaccount.google.com/security
# 2. Activa la verificación en dos pasos
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Genera una nueva contraseña para "Correo"
# 5. Usa esa contraseña aquí (sin espacios)

EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-contraseña-de-aplicacion-de-16-caracteres

# URL del Frontend
FRONTEND_URL=http://localhost:8080

# Orígenes permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
