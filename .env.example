# ==================== CONFIGURACIÓN DE SEGURIDAD ====================

# SECRET_KEY: Clave secreta para JWT (OBLIGATORIO en producción)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_here_change_this

# SESSION_SECRET: Clave para sesiones (opcional)
SESSION_SECRET=your_session_secret_here

# ==================== BASE DE DATOS ====================

# DATABASE_URL: URL de conexión a la base de datos
# Ejemplos:
# MySQL: mysql+pymysql://user:password@localhost/ndata
# PostgreSQL: postgresql://user:password@localhost/ndata
DATABASE_URL=mysql+pymysql://root@localhost/ndata

# ==================== CONFIGURACIÓN DE EMAIL ====================

# Configuración SMTP para envío de emails (recuperación de contraseña, asignación de plan, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@gmail.com
# URL del logo que aparece en la cabecera de los correos (debe ser accesible por internet)
EMAIL_LOGO_URL=https://utridata.com/logo-light.png

# ==================== CONFIGURACIÓN DE APLICACIÓN ====================

# ENVIRONMENT: Entorno de ejecución (development, production)
ENVIRONMENT=development

# BASE_URL: URL base del backend
BASE_URL=http://localhost:8000

# FRONTEND_URL: URL del frontend para links en emails
FRONTEND_URL=http://localhost:8080

# ALLOWED_ORIGINS: Orígenes permitidos para CORS (separados por comas)
# En producción, especificar dominios exactos
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==================== CONFIGURACIÓN OPCIONAL ====================

# DEBUG: Modo debug (True/False)
DEBUG=False

# LOG_LEVEL: Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
